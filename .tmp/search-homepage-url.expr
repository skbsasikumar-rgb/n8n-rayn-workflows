={{ (() => { const input = $('Normalize Input').item.json || {}; const collapse = (value) => String(value || '').replace(/\s+/g, ' ').trim(); const sanitize = (value) => collapse(String(value || '').replace(/\([^)]*\)/g,' ').replace(/\bdr\b\.?\s+[a-z][a-z'-]*(?:\s+[a-z][a-z'-]*){0,4}$/i,' ')); const locations = new Set(['singapore','bishan','novena','orchard','tampines','toa','payoh','jurong','hougang','sengkang','woodlands','yishun','punggol','serangoon','ang','mo','kio','bedok','clementi','queenstown','bukit','batok','choa','chu','kang','pasir','ris','geylang','kallang','marine','parade','potong','redhill','sin','ming','merah']); const toTokens = (value) => collapse(value).toLowerCase().replace(/[^a-z0-9+]+/g, ' ').split(' ').filter(Boolean); const deriveBrand = (name) => { const originalTokens = toTokens(name); const filtered = originalTokens.filter((token) => !locations.has(token)); const selected = filtered.length ? filtered : originalTokens; return collapse(selected.join(' ')); }; const original = sanitize(String(input.search_loose || input.company_name || '').trim()) || sanitize(String(input.company_name || '').trim()); const brand = deriveBrand(original); const shortBrand = collapse(brand.replace(/\b(?:pte|ltd|limited|private|holdings|group|company)\b/gi, ' ')); const coreBrand = collapse(brand.replace(/\b(?:medical|clinic|centre|center|family|health|care|group|holdings|services|surgery)\b/gi, ' ')); const terms = []; if (brand) terms.push(brand); if (original && original.toLowerCase() !== brand.toLowerCase()) terms.push(original); if (shortBrand && shortBrand.toLowerCase() !== brand.toLowerCase()) terms.push(shortBrand); if (coreBrand && coreBrand.length >= 3 && coreBrand.toLowerCase() !== shortBrand.toLowerCase()) terms.push(coreBrand); terms.push(shortBrand || brand || original); terms.push('Singapore'); terms.push('official website'); const q = terms.filter(Boolean).join(' '); const host = 'searxng-railway-production-518a.up.railway.app'; return 'https://' + host + '/search?q=' + encodeURIComponent(q) + '&format=json&language=en-SG&categories=general&engines=google,bing,duckduckgo,startpage,brave'; })() }}

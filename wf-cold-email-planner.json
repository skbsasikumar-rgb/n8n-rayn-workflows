        "url": "={{ 'https://nocodb-production-f802.up.railway.app/api/v1/db/data/noco/pb7f1zou786xyqc/mey3zgihq7o4at9?where=' + encodeURIComponent('(status,eq,completed)~and(best_url,notblank)~and(duplicate_of_id,blank)') + '&fields=Id,company_name,company_homepage_name,parent_company,best_url,canonical_domain,website_content,source_urls,selected_contact_name,selected_contact_title,selected_contact_role,selected_contact_email,validated_email,selected_contact_linkedin_url,do_not_contact,unsubscribe_status,email_source&limit=' + String(($json.body && $json.body.limit) || $json.limit || 5) + '&sort=Id' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {}
      },
      "id": "get-outreach-rows",
      "name": "Get Outreach Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        100
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "d5Rz1LXeEoHMrZwo",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = Array.isArray($json.list) ? $json.list : [];\nconst draftOnly = true;\nconst blockedStatuses = new Set(['unsubscribed', 'bounced', 'complained']);\nconst textFields = ['company_homepage_name', 'parent_company', 'best_url', 'canonical_domain', 'website_content', 'source_urls', 'selected_contact_name', 'selected_contact_title', 'selected_contact_role', 'selected_contact_email', 'selected_contact_linkedin_url', 'validated_email', 'unsubscribe_status', 'email_source'];\nconst output = [];\nfor (const row of rows) {\n  const normalized = { ...row };\n  for (const field of textFields) normalized[field] = String(normalized[field] || '').trim();\n  normalized.unsubscribe_status = normalized.unsubscribe_status || 'active';\n  normalized.do_not_contact = normalized.do_not_contact === true || String(normalized.do_not_contact).toLowerCase() === 'true';\n  const unsub = normalized.unsubscribe_status.toLowerCase();\n  const hasEmail = Boolean(String(normalized.selected_contact_email || normalized.validated_email || '').trim());\n  if (normalized.do_not_contact) continue;\n  if (blockedStatuses.has(unsub)) continue;\n  if (!hasEmail && !draftOnly) continue;\n  output.push({ json: { ...normalized, draft_only: draftOnly } });\n}\nreturn output;"
      },
      "id": "rows-to-items",
      "name": "Rows To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ String($env.CRAWL4AI_SCRAPER_URL || 'https://n8n-rayn-workflows-production.up.railway.app/scrape').replace(/\\/scrape$/, '/outreach-plan') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "outreach-plan",
      "name": "Generate Outreach Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const patches = [];\nconst errors = [];\nfor (const item of items) {\n  const body = item.json || {};\n  if (body.patch && body.patch.Id) {\n    patches.push(body.patch);\n  } else {\n    errors.push({ row_id: body.row_id || '', error: body.error || 'missing_patch' });\n  }\n}\nreturn [{ json: { patches, errors, count: patches.length } }];"
      },
      "id": "collect-patches",
      "name": "Collect NocoDB Patches",

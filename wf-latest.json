      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const list = ($json.list || []);\nconst cutoffMs = Number($('Cleanup Stuck Processing').first().json.cutoff_ms || 0);\nfunction parseUpdatedAt(value) {\n  const raw = String(value || '').trim();\n  if (!raw) return NaN;\n  const iso = raw.includes('T') ? raw : raw.replace(' ', 'T');\n  const ts = Date.parse(iso);\n  return Number.isNaN(ts) ? NaN : ts;\n}\nconst stale = list.filter(row => {\n  const ts = parseUpdatedAt(row.UpdatedAt);\n  return Number.isFinite(ts) && ts < cutoffMs;\n});\nif (stale.length === 0) {\n  return [{ json: { _skip: true, cleanup_count: 0 } }];\n}\nconst payload = stale.map(r => ({ Id: r.Id, status: 'pending' }));\nreturn [{ json: { _skip: false, cleanup_count: stale.length, payload } }];"
      }
